{
  "_comment": "Verified on a Galaxy A07 (2026-11-13): YouTube (all rules) and the Instagram view-id rule. Not verified: the Instagram Reels tab rule (its description could not be read). Capture with scripts/dev/capture-ids.sh (or dumpsys activity top when uiautomator never goes idle).",
  "schemaVersion": 1,
  "minAppVersion": 1,
  "rulesetVersion": 2,
  "updatedAt": "2026-11-13",
  "apps": {
    "com.google.android.youtube": {
      "rules": [
        {
          "id": "yt-shorts-player",
          "kind": "VIEW_ID",
          "values": [
            "com.google.android.youtube:id/reel_recycler",
            "com.google.android.youtube:id/reel_player_page_container"
          ],
          "minHeightRatio": 0.6
        },
        {
          "id": "yt-shorts-tab-selected",
          "kind": "DESC",
          "values": [
            "Shorts"
          ],
          "requireSelected": true
        }
      ],
      "scrollHeuristic": {
        "enabled": true,
        "pageChanges": 3,
        "windowMs": 20000,
        "classNames": [
          "androidx.recyclerview.widget.RecyclerView",
          "androidx.viewpager2.widget.ViewPager2",
          "android.support.v7.widget.RecyclerView"
        ]
      }
    },
    "com.instagram.android": {
      "rules": [
        {
          "id": "ig-clips-viewer",
          "kind": "VIEW_ID",
          "values": [
            "com.instagram.android:id/clips_viewer_view_pager",
            "com.instagram.android:id/clips_swipe_refresh_container"
          ],
          "minHeightRatio": 0.6
        },
        {
          "id": "ig-reels-tab-selected",
          "kind": "DESC",
          "values": [
            "Reels"
          ],
          "requireSelected": true
        }
      ],
      "scrollHeuristic": {
        "enabled": true,
        "pageChanges": 3,
        "windowMs": 20000,
        "classNames": [
          "androidx.viewpager.widget.ViewPager",
          "androidx.recyclerview.widget.RecyclerView"
        ]
      }
    }
  }
}
